{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fmf-dinner-sign-up",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "vars": {
    "SUPABASE_URL": "https://qpkmqrdmjfdmrherqmia.supabase.co",
    "VITE_SUPABASE_URL": "https://qpkmqrdmjfdmrherqmia.supabase.co",
    "VITE_SUPABASE_PROJECT_ID": "qpkmqrdmjfdmrherqmia"
  },
  "triggers": {
    // Runs daily at 9am UTC — picks up any scheduled email templates that are due.
    "crons": ["0 9 * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
